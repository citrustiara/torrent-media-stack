# System & User Settings
PUID=1000
PGID=1000
TZ=Etc/UTC

# Shared media root folder where downloads land
# (Can be configured using `./media-stack init --dest /path/to/media`)
MEDIA_ROOT=./data

# Container Published Ports
QBITTORRENT_WEBUI_PORT=8080
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
JELLYSEERR_PORT=5055

# Service Passwords & Auth
QBITTORRENT_HOST=qbittorrent
QBITTORRENT_PORT=8080
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=adminadmin

# API Keys (Auto-populated by `./media-stack up` provisioner if blank)
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=

# Default Safe Indexers to configure in Prowlarr
# (Excludes Pirate Bay; uses 1337x, Nyaa.si, TorrentGalaxy, EZTV, YTS, LimeTorrents, RuTracker)
PROWLARR_INDEXERS=1337x,Nyaa.si,TorrentGalaxy,EZTV,YTS,LimeTorrents,RuTracker
PROWLARR_APP_PROFILE_ID=1
