#!/usr/bin/env bash
set -e

STACK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$STACK_DIR/.env"
ENV_EXAMPLE="$STACK_DIR/.env.example"

ALL_SERVICES=("qbittorrent" "prowlarr" "sonarr" "radarr" "jellyseerr" "jellyfin")

show_help() {
  echo "Usage: ./media-stack <command> [services/presets] [options]"
  echo ""
  echo "Commands:"
  echo "  init [--dest <path>]             Initialize stack configuration & media storage"
  echo "  up [services...] [options]       Start selected or all Docker services"
  echo "  down [services...]               Stop selected or all Docker services"
  echo "  restart [services...]            Restart selected or all Docker services"
  echo "  status                           Check stack health & print active Web UI links"
  echo "  logs [services...]               Tail container logs"
  echo "  request <name>                   Request TV series / Anime"
  echo "  request-movie <name>             Request Movie"
  echo "  request-game <name>              Search & download PC Game (FitGirl/DODI repacks/ISOs)"
  echo "  search <name>                    Interactively search releases (Anime, TV, Movies, Games)"
  echo ""
  echo "Presets for 'up' / 'down':"
  echo "  minimal | core                   qbittorrent + prowlarr (quick searches & downloads)"
  echo "  arr | automation                 qbittorrent + prowlarr + sonarr + radarr"
  echo "  streaming | player               jellyfin + jellyseerr"
  echo "  all (default)                    All 6 services"
  echo ""
  echo "Individual Services & Aliases:"
  echo "  qbittorrent (qbit), prowlarr (prowl), sonarr, radarr, jellyseerr (seerr), jellyfin (jelly)"
  echo ""
  echo "Examples:"
  echo "  ./media-stack up minimal         # Only starts qBittorrent & Prowlarr"
  echo "  ./media-stack up qbit prowlarr   # Starts specific containers"
  echo "  ./media-stack up --no-provision  # Starts without running provisioner script"
  echo "  ./media-stack down sonarr        # Stops only Sonarr"
  echo ""
}

# Resolve aliases and presets to actual Docker compose service names
resolve_services() {
  local input=("$@")
  local resolved=()

  for item in "${input[@]}"; do
    IFS=',' read -ra ADDR <<< "$item"
    for sub in "${ADDR[@]}"; do
      case "$(echo "$sub" | tr '[:upper:]' '[:lower:]')" in
        minimal|core|basic)
          resolved+=("qbittorrent" "prowlarr")
          ;;
        arr|automation)
          resolved+=("qbittorrent" "prowlarr" "sonarr" "radarr")
          ;;
        streaming|player)
          resolved+=("jellyfin" "jellyseerr")
          ;;
        all)
          resolved+=("${ALL_SERVICES[@]}")
          ;;
        qbit|qbittorrent)
          resolved+=("qbittorrent")
          ;;
        prowl|prowlarr)
          resolved+=("prowlarr")
          ;;
        sonarr)
          resolved+=("sonarr")
          ;;
        radarr)
          resolved+=("radarr")
          ;;
        seerr|jellyseerr)
          resolved+=("jellyseerr")
          ;;
        jelly|jellyfin)
          resolved+=("jellyfin")
          ;;
        *)
          echo "Warning: Unknown service or preset '$sub' (skipping)" >&2
          ;;
      esac
    done
  done

  printf "%s\n" "${resolved[@]}" | sort -u
}

if [ -z "$1" ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  show_help
  exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
  init)
    DEST_DIR=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --dest)
          DEST_DIR="$2"
          shift 2
          ;;
        *)
          shift
          ;;
      esac
    done

    if [ -z "$DEST_DIR" ]; then
      read -p "Enter destination path for media storage (default: ./data): " DEST_DIR
      DEST_DIR="${DEST_DIR:-./data}"
    fi

    DEST_DIR=$(eval echo "$DEST_DIR")
    mkdir -p "$DEST_DIR/movies" "$DEST_DIR/tv" "$DEST_DIR/anime" "$DEST_DIR/games" "$DEST_DIR/torrents"
    ABS_DEST="$(cd "$DEST_DIR" && pwd)"

    if [ ! -f "$ENV_FILE" ]; then
      cp "$ENV_EXAMPLE" "$ENV_FILE"
    fi

    if grep -q "^MEDIA_ROOT=" "$ENV_FILE"; then
      sed -i.bak "s|^MEDIA_ROOT=.*|MEDIA_ROOT=$ABS_DEST|" "$ENV_FILE" && rm -f "$ENV_FILE.bak"
    else
      echo "MEDIA_ROOT=$ABS_DEST" >> "$ENV_FILE"
    fi

    echo "✓ Initialized stack! Media storage path set to: $ABS_DEST"
    echo "  Created directories: /movies, /tv, /anime, /games, /torrents"
    ;;

  up)
    if [ ! -f "$ENV_FILE" ]; then
      echo "Initializing with default directory './data'..."
      "$0" init --dest ./data
    fi

    TARGET_SERVICES=()
    NO_PROVISION=0

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --no-provision)
          NO_PROVISION=1
          shift
          ;;
        --only|--services)
          TARGET_SERVICES+=("$2")
          shift 2
          ;;
        *)
          TARGET_SERVICES+=("$1")
          shift
          ;;
      esac
    done

    FINAL_SERVICES=()
    if [ ${#TARGET_SERVICES[@]} -eq 0 ]; then
      FINAL_SERVICES=("${ALL_SERVICES[@]}")
    else
      while IFS= read -r s; do
        [[ -n "$s" ]] && FINAL_SERVICES+=("$s")
      done < <(resolve_services "${TARGET_SERVICES[@]}")
    fi

    if [ ${#FINAL_SERVICES[@]} -eq 0 ]; then
      echo "Error: No valid services specified to start."
      exit 1
    fi

    echo "Starting Docker Compose services: ${FINAL_SERVICES[*]}..."
    docker compose -f "$STACK_DIR/docker-compose.yml" up -d "${FINAL_SERVICES[@]}"

    if [ "$NO_PROVISION" -eq 0 ]; then
      echo "Running automatic stack provisioner for active services..."
      python3 "$STACK_DIR/scripts/provision_stack.py" || true
    fi
    ;;

  down)
    if [ $# -eq 0 ]; then
      echo "Stopping all media stack services..."
      docker compose -f "$STACK_DIR/docker-compose.yml" down
      echo "✓ Stopped all media stack services."
    else
      TARGET_SERVICES=()
      while IFS= read -r s; do
        [[ -n "$s" ]] && TARGET_SERVICES+=("$s")
      done < <(resolve_services "$@")

      if [ ${#TARGET_SERVICES[@]} -gt 0 ]; then
        echo "Stopping services: ${TARGET_SERVICES[*]}..."
        docker compose -f "$STACK_DIR/docker-compose.yml" stop "${TARGET_SERVICES[@]}"
        echo "✓ Stopped: ${TARGET_SERVICES[*]}"
      else
        docker compose -f "$STACK_DIR/docker-compose.yml" down
      fi
    fi
    ;;

  restart)
    "$0" down "$@"
    "$0" up "$@"
    ;;

  status)
    echo "=== Container Status ==="
    docker compose -f "$STACK_DIR/docker-compose.yml" ps
    echo ""
    echo "=== Web Interfaces ==="
    echo "🎥 Jellyfin (Media Streaming): http://localhost:8096"
    echo "🍿 Jellyseerr (Request UI):    http://localhost:5055"
    echo "📺 Sonarr (TV/Anime):          http://localhost:8989"
    echo "🎬 Radarr (Movies):            http://localhost:7878"
    echo "🔍 Prowlarr (Indexers):        http://localhost:9696"
    echo "⚡ qBittorrent (Downloads):    http://localhost:8080"
    ;;

  logs)
    if [ $# -eq 0 ]; then
      docker compose -f "$STACK_DIR/docker-compose.yml" logs -f
    else
      TARGET_SERVICES=()
      while IFS= read -r s; do
        [[ -n "$s" ]] && TARGET_SERVICES+=("$s")
      done < <(resolve_services "$@")
      docker compose -f "$STACK_DIR/docker-compose.yml" logs -f "${TARGET_SERVICES[@]}"
    fi
    ;;

  request|request-movie|request-game|search)
    cmd="$1"
    shift
    python3 "$STACK_DIR/scripts/cli_handler.py" "$cmd" "$@"
    ;;

  *)
    show_help
    exit 1
    ;;
esac
